<Window x:Class="VideoIA_Tri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner Vidéo IA Pro - V1.3" Height="700" Width="1200"
        Background="{DynamicResource BgPrincipal}" Foreground="{DynamicResource TextePrincipal}"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils supérieure -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Name="BtnChoisirDossier" Content="Choisir Dossier" Click="BtnChoisirDossier_Click"
                    Grid.Column="0" Width="150" Height="40"
                    Background="{DynamicResource CouleurPrimaire}" Foreground="{DynamicResource TexteBouton}"
                    FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0"/>

            <Button Name="BtnLancerAnalyse" Content="► Lancer l'Analyse" Click="BtnLancerAnalyse_Click"
                    Grid.Column="1" Width="150" Height="40"
                    Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TexteSecondaire}"
                    FontWeight="Bold" BorderBrush="{DynamicResource Bordure}" BorderThickness="1"/>

            <TextBlock Text="Prêt" Name="TxtStatut" Grid.Column="2"
                       VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Margin="15,0,0,0"/>

            <Button Name="BtnChangerDisposition" Content="Inverser Disposition" Click="BtnChangerDisposition_Click"
                    Grid.Column="3" Height="40" Padding="10,0" Margin="0,0,10,0"
                    Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TextePrincipal}"
                    BorderBrush="{DynamicResource Bordure}"/>

            <Button Name="BtnChangerTheme" Content="Mode Sombre" Click="BtnChangerTheme_Click"
                    Grid.Column="4" Height="40" Padding="10,0" Margin="0,0,10,0"
                    Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TextePrincipal}"
                    BorderBrush="{DynamicResource Bordure}"/>

            <Button Content="?" Grid.Column="5" Width="40" Height="40"
                    Background="{DynamicResource CouleurBoutonBleu}" Foreground="{DynamicResource TexteBouton}"
                    FontWeight="Bold" BorderThickness="0"
                    Click="BtnApropos_Click"/>
        </Grid>

        <!-- Barre de recherche et sélection processeur IA -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Moteur IA :" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <ComboBox Name="CboPuce" Width="170"
                      Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TextePrincipal}"
                      BorderBrush="{DynamicResource Bordure}">
                <ComboBoxItem Content="Automatique" IsSelected="True"/>
                <ComboBoxItem Content="NPU (VPU/DirectML)"/>
                <ComboBoxItem Content="GPU (CUDA/DirectML)"/>
                <ComboBoxItem Content="CPU / iGPU"/>
            </ComboBox>

            <TextBlock Text="Filtrer par objet :" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,10,0"/>
            <ComboBox Name="CboFiltreType" Width="120"
                      Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TextePrincipal}"
                      BorderBrush="{DynamicResource Bordure}" SelectionChanged="Filtre_Changed">
                <ComboBoxItem Content="Tous" IsSelected="True"/>
                <ComboBoxItem Content="Personne"/>
                <ComboBoxItem Content="Voiture"/>
            </ComboBox>

            <TextBlock Text="Rechercher fichier :" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,10,0"/>
            <TextBox Name="TxtRecherche" Width="180"
                     Background="{DynamicResource BgSecondaire}" Foreground="{DynamicResource TextePrincipal}"
                     BorderBrush="{DynamicResource Bordure}" TextChanged="Filtre_Changed"/>
        </StackPanel>

        <!-- Zone Principale (Vidéo + Tableau) -->
        <Grid Grid.Row="2" Name="MainContenuGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ColGauche" Width="40*"/>
                <ColumnDefinition Name="ColDroite" Width="60*"/>
            </Grid.ColumnDefinitions>

            <Border Name="ZoneVideo" Grid.Column="0" Background="Black"
                    BorderBrush="{DynamicResource Bordure}" BorderThickness="1" Margin="0,0,10,0">
                <Image Name="EcranLive" Stretch="Uniform"/>
            </Border>

            <DataGrid Name="ZoneTableau" Grid.Column="1"
                      Background="{DynamicResource BgSecondaire}" BorderBrush="{DynamicResource Bordure}"
                      BorderThickness="1" HeadersVisibility="Column" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Preuve">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePreuve}" Height="70" Stretch="Uniform"
                                       Cursor="Hand"
                                       PreviewMouseLeftButtonUp="ImagePreuve_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Événement" Binding="{Binding TypeEvenement}" Width="*"/>
                    <DataGridTextColumn Header="Heure" Binding="{Binding HeureIncrustee}"/>
                    <DataGridTextColumn Header="Chrono" Binding="{Binding RepereTempsLecteur}"/>
                    <DataGridTextColumn Header="Fichier" Binding="{Binding FichierSource}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Barre de progression -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar Name="BarreProgression" Grid.Column="0" Height="40" Value="0"
                         Background="{DynamicResource BgSecondaire}" BorderBrush="{DynamicResource Bordure}"
                         Margin="0,0,10,0"/>

            <TextBlock Name="TxtPourcentage" Text="0%" Grid.Column="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="Bold" Foreground="{DynamicResource TexteSecondaire}"/>

            <Button Name="BtnExporterExcel" Content="Exporter Excel" Click="BtnExporterExcel_Click"
                    Grid.Column="1" Width="150" Height="40"
                    Background="{DynamicResource CouleurPrimaire}" Foreground="{DynamicResource TexteBouton}"
                    FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>