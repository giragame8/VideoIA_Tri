<Window x:Class="VideoIA_Tri.FenetreApropos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informations Système" Height="396.911" Width="450"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="White" WindowStyle="ToolWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Scanner Vidéo IA Pro" FontSize="22" FontWeight="Bold" Foreground="#68217A" HorizontalAlignment="Center"/>
        <TextBlock Text="Par Elliott Magnier" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,20"/>

        <Border BorderBrush="#333" BorderThickness="0,1,0,1" Padding="10">
            <StackPanel>
                <TextBlock Name="TxtUserLabel" Text="Utilisateur : Chargement..." FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Name="TxtEntrepriseLabel" Text="Entreprise : Chargement..." Foreground="LightGray" Margin="0,0,0,5"/>
                <TextBlock Name="TxtDateButoire" Text="Expire le : --/--/----" Foreground="#FFCC00" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="Version : V1.3.0" HorizontalAlignment="Center"/>
            <TextBlock Name="TxtLicence" Text="Licence : ..." HorizontalAlignment="Center" Foreground="Gray" Margin="0,5,0,15" FontSize="10" TextWrapping="Wrap"/>
            <TextBlock Text="Support : elliottmag8@gmail.com" HorizontalAlignment="Center" Foreground="#FF007ACC"/>
        </StackPanel>

        <Button Content="Fermer" Width="100" Margin="0,20,0,0" Click="BtnFermer_Click" Background="#68217A" Foreground="White" Height="30" BorderThickness="0"/>
    </StackPanel>
</Window>