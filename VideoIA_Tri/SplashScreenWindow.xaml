<Window x:Class="VideoIA_Tri.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chargement..." Height="330" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="#00000000"
        ShowInTaskbar="False" Topmost="True">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Scanner Vidéo IA Pro"
                       Foreground="#4DA3FF" FontSize="38" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Créé par Elliott Magnier"
                       Foreground="#CCCCCC" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Ellipse Width="45" Height="45" Stroke="#4DA3FF" StrokeThickness="4">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="StrokeThickness"
                                                 From="2" To="6" Duration="0:0:1"
                                                 AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <TextBlock Name="TxtStatus"
                       Text="Initialisation du moteur d'Intelligence Artificielle..."
                       Foreground="#CCCCCC" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <TextBlock Text="Version V1.2.95"
                       Foreground="#888888" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <ProgressBar Name="BarreSplash"
                     Grid.Row="1" Height="8" Margin="20"
                     Minimum="0" Maximum="100" Value="0"
                     Foreground="#4DA3FF" Background="#333"/>
    </Grid>
</Window>
