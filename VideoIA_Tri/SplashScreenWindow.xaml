<Window x:Class="VideoIA_Tri.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chargement..." Height="300" Width="550"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" Background="#1E1E1E"
        BorderBrush="#FF007ACC" BorderThickness="2">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Scanner Vidéo IA Pro" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Créé par Elliott Magnier" Foreground="#FF007ACC" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
            <ProgressBar IsIndeterminate="True" Width="250" Height="6" Foreground="#FF007ACC" Background="#333333" BorderThickness="0" Margin="0,0,0,25"/>
            <TextBlock Text="Version V1.2.3" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="Initialisation du moteur d'Intelligence Artificielle..." Foreground="DarkGray" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>