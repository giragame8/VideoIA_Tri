<Window x:Class="VideoIA_Tri.FenetreEnregistrement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activation VideoIA_Tri" Height="480" Width="380"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" FontFamily="Segoe UI">

    <Border Background="White" Margin="15" Padding="20" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Activation Sécurisée" FontSize="20" FontWeight="Bold" Foreground="#7B1FA2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Prénom :" FontWeight="SemiBold"/>
            <TextBox Name="TxtPrenom" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>

            <TextBlock Text="Nom :" FontWeight="SemiBold"/>
            <TextBox Name="TxtNom" Height="25" Margin="0,5,0,10" Background="#F9F9F9"/>

            <TextBlock Text="Votre Code Machine (À donner à l'admin) :" FontWeight="SemiBold" Foreground="#D32F2F"/>
            <TextBox Name="TxtCodeMachine" Height="25" Margin="0,5,0,10" IsReadOnly="True" Background="#EEEEEE" FontWeight="Bold" TextAlignment="Center"/>

            <TextBlock Text="Clé de Licence :" FontWeight="SemiBold"/>
            <TextBox Name="TxtLicence" Height="25" Margin="0,5,0,20" Background="#F9F9F9"/>

            <!-- BOUTON D'ACTIVATION CLASSIQUE -->
            <Button Name="BtnValider" Content="Valider et Activer" Height="40" Background="#7B1FA2" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnValider_Click"/>

            <TextBlock Text="--- OU ---" HorizontalAlignment="Center" Margin="0,15,0,15" Foreground="#888"/>

            <!-- NOUVEAU BOUTON ESSAI GRATUIT -->
            <Button Name="BtnEssai" Content="Démarrer l'essai gratuit (15 jours)" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnEssai_Click"/>
        </StackPanel>
    </Border>
</Window>